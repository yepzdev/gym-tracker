{
  "name": "GYM tracker",
  "short_name": "Gym",
  "description": "Log your workouts and track your progress over time.",
  "display": "standalone",
  "theme_color": "#000000",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "32x32 48x48",
      "type": "image/x-icon"
    },
    {
      "src": "web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "related_applications": [
    {
      "platform": "play",
      "id": "com.example.gymtracker",
      "url": "https://play.google.com/store/apps/details?id=com.example.gymtracker"
    }
  ]
}